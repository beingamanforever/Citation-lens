{
  "mcpServers": {
    "citation-lens": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--with-requirements",
        "${CLAUDE_PLUGIN_ROOT}/requirements-runtime.txt",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/run.py"
      ],
      "env": {
        "CITATION_LENS_DATA": "${CLAUDE_PLUGIN_DATA}/data"
      }
    }
  }
}
